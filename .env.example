# ── Frontend (Vite) — safe to expose in the browser ─────────────────────────
# These are the ONLY secrets that belong in the frontend. The anon key is
# meant to be public; every table it can touch is protected by Row Level
# Security policies in supabase/schema.sql + supabase/migrations/.
VITE_SUPABASE_URL=https://tlzsipeyxrkvpjfcyssw.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRsenNpcGV5eHJrdnBqZmN5c3N3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQ5OTIzODYsImV4cCI6MjEwMDU2ODM4Nn0.ZyyiPvzUfAoQnD3di7l0oYeTArrI2CGOAIUHEd9cPAc
VITE_ENV=development

# ── Optional Frontend Integrations ──────────────────────────────────────────
# These are safe to expose (public keys only)

# Error Tracking (Sentry)
# Get from: https://sentry.io → Create Project → Copy DSN
# VITE_SENTRY_DSN=https://abc123@o123456.ingest.sentry.io/123456

# Analytics (Google Analytics 4)
# Get from: https://analytics.google.com → Admin → Data Streams → Copy Measurement ID
# VITE_GA_ID=G-XXXXXXXXXX

# ── Everything else lives on the server, NOT here ───────────────────────────
# Paymob credentials, Resend's API key, and the Supabase service-role key
# must never be set as VITE_ variables — anything with that prefix is
# bundled into the browser JS. Instead, set these as Supabase Edge Function
# secrets:
#
#   supabase secrets set PAYMOB_API_KEY=...
#   supabase secrets set PAYMOB_INTEGRATION_ID_CARD=...
#   supabase secrets set PAYMOB_IFRAME_ID=...
#   supabase secrets set PAYMOB_HMAC_SECRET=...
#   supabase secrets set RESEND_API_KEY=...
#   supabase secrets set RESEND_FROM_EMAIL="NERVE <orders@yourdomain.com>"
#   supabase secrets set STORE_URL=https://your-production-domain.com
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically into
# Edge Functions by Supabase — you do not set those yourself.
#
# See SETUP.md for the full walkthrough.
