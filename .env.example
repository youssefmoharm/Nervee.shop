# =============================================================================
# NERVE — Environment Variables
# =============================================================================
# PUBLIC vs SECRET: Anything prefixed VITE_ is bundled into the browser JS
# and is visible to anyone. NEVER put secrets there. Server secrets are set
# via `supabase secrets set KEY=value` and only visible inside Edge Functions.
# =============================================================================

# ── Frontend (Vite) — PUBLIC, bundled to browser ─────────────────────────────
# REQUIRED for both dev and production. In production the build FAILS if these
# are missing (see src/lib/supabase.ts). Set them in Vercel → Settings →
# Environment Variables (Production + Preview).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_ENV=development

# ── Optional Frontend Integrations — PUBLIC ──────────────────────────────────
# Safe to expose. Omit if not used.

# Sentry — Error tracking
# Get from: https://sentry.io → Create Project → Copy DSN
# VITE_SENTRY_DSN=https://abc123@o123456.ingest.sentry.io/123456

# Google Analytics 4
# Get from: https://analytics.google.com → Admin → Data Streams → Copy Measurement ID
# VITE_GA_ID=G-XXXXXXXXXX

# Meta Pixel (Facebook/Instagram)
# Get from: https://business.facebook.com → Data Sources → Pixels → Copy Pixel ID
# VITE_META_PIXEL_ID=XXXXXXXXXXXXXXX

# ── Backend Secrets — SERVER ONLY, never VITE_ ───────────────────────────────
# Set via: supabase secrets set KEY=value
# List:    supabase secrets list
# These are injected as Deno.env.get('KEY') inside Edge Functions only.

# Gemini AI (chatbot — chat-ai function)
# Get from: https://aistudio.google.com/apikey
# Preferred name: GOOGLE_GEMINI_API_KEY (OPENAI_API_KEY also accepted as alias)
# GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Resend — transactional email (all order/support emails)
# Get from: https://resend.com/api-keys
# Required for: create-order, send-email, back-in-stock, abandoned carts
# RESEND_API_KEY=re_xxx
# RESEND_FROM_EMAIL="NERVE <orders@nerveey.shop>"
# STORE_URL=https://nerveey.shop

# Cron — scheduled jobs (optional, for extra protection of scheduler endpoints)
# If set, scheduler edge functions also require this header: x-cron-secret
# CRON_SECRET=your_random_32_char_secret

# ── Everything else is injected automatically ─────────────────────────────────
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase into
# Edge Functions — you do NOT set them yourself (neither as VITE_ nor secret).
#
# See SETUP.md and PRODUCTION_READINESS.md for full setup.
